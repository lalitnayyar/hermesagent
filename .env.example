# AgentFlow UI
AGENTFLOW_FRONTEND_PORT=3080

# AgentFlow Backend
AGENTFLOW_BACKEND_PORT=8080
AGENTFLOW_ENV=development
AGENTFLOW_LOG_LEVEL=INFO
AGENTFLOW_SECRET_KEY=change-me-in-production
AGENTFLOW_ADMIN_USERNAME=admin
AGENTFLOW_ADMIN_PASSWORD=change-me
AGENTFLOW_SIMULATION_MODE=true
AGENTFLOW_MAX_PARALLEL_AGENTS=7
AGENTFLOW_MAX_CONFIGURED_AGENTS=25

# Database (SQLite inside Docker)
AGENTFLOW_DATABASE_URL=sqlite:////app/data/database/agentflow.db

# Hermes Agent integration
# When running locally, point to your existing Hermes API server:
HERMES_API_BASE_URL=http://127.0.0.1:8642
# When running inside Docker, use the service name:
# HERMES_API_BASE_URL=http://hermes-agent:8642
HERMES_GATEWAY_URL=http://127.0.0.1:9119
HERMES_WORKSPACE_URL=http://127.0.0.1:3000
HERMES_API_SERVER_KEY=your-hermes-api-key-here
HERMES_DEFAULT_PROFILE=default
HERMES_REQUEST_TIMEOUT=300
HERMES_STREAMING_ENABLED=true
HERMES_VERIFY_TLS=false

# Docker network that already contains Hermes Agent and Hermes Workspace.
# Find it with: docker network ls
HERMES_NETWORK=hermes-network

# Model provider keys (optional if using Nous Portal / Hermes gateway)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
